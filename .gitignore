*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
uv.lock.bak

