# ============================================================================
# homelab-agent-mesh - Environment Template (.env.example)
# Copy to `.env` (gitignored) and populate with your local infrastructure values.
# RFC 5737 TEST-NET-1 placeholder IPs (192.0.2.x) are used below.
# ============================================================================

# --- Google AI Studio / Gemini API ------------------------------------------
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# --- Home Assistant Endpoints & Token ---------------------------------------
HA_BASE_URL="http://192.0.2.10:8123"
HA_WS_URL="ws://192.0.2.10:8123/api/websocket"
HA_ACCESS_TOKEN="YOUR_HOME_ASSISTANT_LONG_LIVED_TOKEN_HERE"

# --- External Home Assistant MCP Server (ha-mcp SSE / Streamable HTTP) ------
HA_MCP_SSE_URL="http://192.0.2.10:8086/sse"
HA_MCP_AUTH_TOKEN=""

# --- Optional Proxmox VE API Credentials ------------------------------------
PROXMOX_API_URL="https://192.0.2.20:8006"
PROXMOX_TOKEN_ID="root@pam!homelab-agent"
PROXMOX_TOKEN_SECRET="00000000-0000-0000-0000-000000000000"
PROXMOX_VERIFY_SSL="false"

# --- Gateway Listener & Optional Bearer Token -------------------------------
APP_HOST="0.0.0.0"
APP_PORT="8080"
LOG_LEVEL="INFO"
API_BEARER_TOKEN=""

# --- Local Storage Paths ----------------------------------------------------
SQLITE_DB_PATH="data/reflections.db"
YAML_CONFIG_PATH="config/settings.yaml"
NEONPLAN_JSON_PATH="/app/data/neonplan.json"
THERMAL_OVERRIDES_PATH="config/thermal_overrides.yaml"

